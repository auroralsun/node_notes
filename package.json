{
  "name": "knowledge-graph-notes",
  "version": "0.1.0",
  "description": "Knowledge graph note-taking desktop app",
  "author": "sun",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "electron:dev": "concurrently -k \"npm:dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "next build && electron-builder",
    "electron:pack": "electron-builder --dir"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "next": "15.2.2",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "concurrently": "^9.1.2",
    "electron": "^35.1.4",
    "electron-builder": "^24.13.3",
    "eslint": "^9.22.0",
    "eslint-config-next": "15.2.2",
    "prisma": "^6.5.0",
    "typescript": "^5.8.2",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "ai.item.knowledge-graph-notes",
    "productName": "Knowledge Graph Notes",
    "directories": {
      "output": "dist"
    },
    "files": [
      ".next/standalone/**/*",
      "electron/**/*",
      "prisma/**/*",
      "next.config.ts",
      "package.json",
      ".env"
    ],
    "extraResources": [
      {
        "from": "prisma",
        "to": "prisma"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "signAndEditExecutable": false
    },
    "afterPack": "electron/after-pack.cjs",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
